    "가장 먼저 끝나는 냄비의 남은 시간을 보여 줘요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukazuje, kolik času zbývá hrnci, který bude hotový první."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser tiden tilbage for den gryde, der bliver færdig først."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt die Restzeit des Topfs, der als Erstes fertig ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δείχνει τον χρόνο που απομένει στην κατσαρόλα που τελειώνει πρώτη."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows the time left on the pot that finishes first."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows the time left on the pan that finishes first."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra el tiempo que le queda a la olla que termina primero."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näyttää ensimmäisenä valmistuvan kattilan jäljellä olevan ajan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche le temps restant de la casserole qui finit en premier."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menampilkan sisa waktu panci yang selesai paling dulu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra il tempo rimasto della pentola che finisce per prima."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いちばん先に終わる鍋の残り時間を表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가장 먼저 끝나는 냄비의 남은 시간을 보여 줘요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser tiden som er igjen for gryta som blir ferdig først."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toont de resterende tijd van de pan die het eerst klaar is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazuje czas pozostały dla garnka, który skończy się pierwszy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra o tempo restante da panela que termina primeiro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывает, сколько осталось кастрюле, которая будет готова первой."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visar hur lång tid som är kvar för kastrullen som blir klar först."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แสดงเวลาที่เหลือของหม้อที่จะเสร็จก่อน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İlk bitecek tencerenin kalan süresini gösterir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiển thị thời gian còn lại của nồi xong sớm nhất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
