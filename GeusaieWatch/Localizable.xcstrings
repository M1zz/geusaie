    "아이폰에서 요리를 시작하면 냄비마다 남은 시간이 여기 보여요" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Začněte vařit na iPhonu a tady uvidíte, kolik času zbývá každému hrnci."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begynd at lave mad på din iPhone for at se hver gryde tid tilbage her."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starte das Kochen auf dem iPhone – dann siehst du hier die Restzeit jedes Topfs."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ξεκινήστε το μαγείρεμα στο iPhone για να βλέπετε εδώ τον χρόνο που απομένει σε κάθε κατσαρόλα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start cooking on your iPhone to see each pot's time left here."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start cooking on your iPhone to see each pan's time left here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empieza a cocinar en el iPhone y aquí verás el tiempo que le queda a cada olla."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aloita ruoanlaitto iPhonella, niin näet täällä jokaisen kattilan jäljellä olevan ajan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lancez la cuisson sur l’iPhone pour voir ici le temps restant de chaque casserole."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mulai memasak di iPhone untuk melihat sisa waktu tiap panci di sini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inizia a cucinare su iPhone e qui vedrai il tempo rimasto per ogni pentola."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhoneで料理を始めると、鍋ごとの残り時間がここに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아이폰에서 요리를 시작하면 냄비마다 남은 시간이 여기 보여요"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begynn å lage mat på iPhone, så ser du tiden som er igjen for hver gryte her."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begin met koken op je iPhone om hier de resterende tijd van elke pan te zien."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zacznij gotować na iPhonie, a tutaj zobaczysz czas pozostały dla każdego garnka."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comece a cozinhar no iPhone para ver aqui o tempo restante de cada panela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Начните готовить на iPhone, и здесь появится оставшееся время каждой кастрюли."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Börja laga mat på iPhone så ser du hur lång tid varje kastrull har kvar här."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เริ่มทำอาหารบน iPhone แล้วเวลาที่เหลือของแต่ละหม้อจะแสดงที่นี่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone’da yemeğe başlayınca her tencerenin kalan süresi burada görünür."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bắt đầu nấu trên iPhone để xem thời gian còn lại của từng nồi tại đây."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 iPhone 上开始烹饪后，这里会显示每口锅的剩余时间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 iPhone 上開始料理後，這裡會顯示每個鍋子的剩餘時間。"
          }
        }
      }
    },
    "아이폰에서 진행 중인 요리의 지금 할 일을 끝내고 다음으로 넘어가요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Označí aktuální krok jídla na iPhonu jako hotový a přejde na další."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markerer det aktuelle trin i retten på din iPhone som færdigt og går videre."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hakt den aktuellen Schritt des Gerichts auf dem iPhone ab und geht zum nächsten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σημειώνει ως ολοκληρωμένο το τρέχον βήμα του φαγητού στο iPhone και περνά στο επόμενο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marks the current task of the dish on your iPhone as done and moves on to the next."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marks the current task of the dish on your iPhone as done and moves on to the next."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marca como hecho el paso actual del plato en el iPhone y pasa al siguiente."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuittaa iPhonella valmistuvan ruoan nykyisen vaiheen tehdyksi ja siirtyy seuraavaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valide l’étape en cours du plat sur l’iPhone et passe à la suivante."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menandai langkah saat ini dari masakan di iPhone sebagai selesai dan lanjut ke berikutnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segna come fatto il passo attuale del piatto su iPhone e passa al successivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhoneで調理中の料理の今のステップを完了にして、次へ進みます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아이폰에서 진행 중인 요리의 지금 할 일을 끝내고 다음으로 넘어가요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markerer gjeldende steg i retten på iPhone som ferdig og går videre til neste."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rondt de huidige stap van het gerecht op je iPhone af en gaat door naar de volgende."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oznacza bieżący krok potrawy na iPhonie jako wykonany i przechodzi do następnego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marca como feita a etapa atual do prato no iPhone e avança para a próxima."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отмечает текущий шаг блюда на iPhone выполненным и переходит к следующему."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klarmarkerar det aktuella steget för rätten på iPhone och går vidare till nästa."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทำเครื่องหมายว่าขั้นตอนปัจจุบันของเมนูบน iPhone เสร็จแล้ว และไปขั้นต่อไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone’daki yemeğin şu anki adımını bitmiş sayar ve sonrakine geçer."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đánh dấu xong bước hiện tại của món đang nấu trên iPhone và chuyển sang bước tiếp theo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将 iPhone 上正在烹饪的菜的当前步骤标为完成，并进入下一步。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將 iPhone 上正在料理的菜目前的步驟標為完成，並進入下一步。"
          }
        }
      }
    },
