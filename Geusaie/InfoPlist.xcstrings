    "NSMicrophoneUsageDescription" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses the microphone so you can say “다음” (Korean for “next”) to move to the next step while you cook."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses the microphone so you can say “다음” (Korean for “next”) to move to the next step while you cook."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "調理中に韓国語の「다음」（「次へ」）と言うだけで手順を進められるよう、マイクを使います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "요리 중에 \"다음\" 한 마디로 단계를 넘기기 위해 마이크를 씁니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Микрофон нужен, чтобы во время готовки переходить к следующему шагу, просто сказав по-корейски «다음» («далее»)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "烹饪时，只需说一声韩语“다음”（“下一步”）就能进入下一步，因此需要使用麦克风。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "烹飪時，只要說一聲韓語「다음」（「下一步」）就能進入下一步，因此需要使用麥克風。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses speech recognition only to catch the Korean word “다음” (“next”). Processed on your device whenever possible."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses speech recognition only to catch the Korean word “다음” (“next”). Processed on your device whenever possible."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "韓国語の「다음」（「次へ」）という言葉だけを聞き取るために、音声認識を使います。可能な限り端末内で処理します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"다음\"이라는 말만 알아듣기 위해 음성 인식을 씁니다. 가능하면 기기 안에서 처리합니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Распознавание речи используется только для того, чтобы услышать корейское слово «다음» («далее»). По возможности обработка идёт на устройстве."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用语音识别，只为听懂韩语“다음”（“下一步”）这个词。如有可能，会在设备上完成处理。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用語音辨識，只為聽懂韓語「다음」（「下一步」）這個詞。如有可能，會在裝置上完成處理。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
