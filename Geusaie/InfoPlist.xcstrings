    "NSMicrophoneUsageDescription" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikrofon se používá, abyste při vaření mohli přejít na další krok vyslovením korejského slova „다음“ („další“)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruger mikrofonen, så du kan gå videre til næste trin under madlavningen ved at sige det koreanske ord “다음” (“næste”)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Mikrofon wird verwendet, damit du beim Kochen mit dem koreanischen Wort „다음“ („weiter“) zum nächsten Schritt springen kannst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρησιμοποιεί το μικρόφωνο ώστε να προχωράτε στο επόμενο βήμα ενώ μαγειρεύετε λέγοντας την κορεατική λέξη «다음» («επόμενο»)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses the microphone so you can say “다음” (Korean for “next”) to move to the next step while you cook."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses the microphone so you can say “다음” (Korean for “next”) to move to the next step while you cook."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa el micrófono para que, mientras cocinas, puedas pasar al siguiente paso diciendo la palabra coreana «다음» («siguiente»)."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käyttää mikrofonia, jotta voit siirtyä ruoanlaiton aikana seuraavaan vaiheeseen sanomalla korean sanan ”다음” (”seuraava”)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilise le micro pour que vous puissiez passer à l’étape suivante en disant le mot coréen « 다음 » (« suivant ») pendant que vous cuisinez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menggunakan mikrofon agar kamu bisa lanjut ke langkah berikutnya sambil memasak dengan mengucapkan kata Korea “다음” (“berikutnya”)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa il microfono per farti passare al passaggio successivo mentre cucini dicendo la parola coreana «다음» («avanti»)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "調理中に韓国語の「다음」（「次へ」）と言うだけで手順を進められるよう、マイクを使います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "요리 중에 \"다음\" 한 마디로 단계를 넘기기 위해 마이크를 씁니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruker mikrofonen slik at du kan gå videre til neste trinn mens du lager mat ved å si det koreanske ordet «다음» («neste»)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruikt de microfoon zodat je tijdens het koken naar de volgende stap kunt gaan door het Koreaanse woord “다음” (“volgende”) te zeggen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa o microfone para você passar à próxima etapa dizendo a palavra coreana “다음” (“próximo”) enquanto cozinha."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Микрофон нужен, чтобы во время готовки переходить к следующему шагу, просто сказав по-корейски «다음» («далее»)."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้ไมโครโฟนเพื่อให้คุณพูดคำภาษาเกาหลี “다음” (“ถัดไป”) เพื่อไปขั้นตอนถัดไประหว่างทำอาหาร"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dùng micrô để bạn nói từ tiếng Hàn “다음” (“tiếp theo”) nhằm chuyển sang bước tiếp theo khi đang nấu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "烹饪时，只需说一声韩语“다음”（“下一步”）就能进入下一步，因此需要使用麦克风。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "烹飪時，只要說一聲韓語「다음」（「下一步」）就能進入下一步，因此需要使用麥克風。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozpoznávání řeči se používá jen k rozpoznání korejského slova „다음“ („další“). Pokud je to možné, zpracovává se přímo v zařízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruger talegenkendelse udelukkende til at genkende det koreanske ord “다음” (“næste”). Behandles på enheden, når det er muligt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Spracherkennung dient nur dazu, das koreanische Wort „다음“ („weiter“) zu erkennen. Sie läuft nach Möglichkeit auf dem Gerät."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρησιμοποιεί την αναγνώριση ομιλίας μόνο για να ακούσει την κορεατική λέξη «다음» («επόμενο»). Όπου είναι δυνατόν, η επεξεργασία γίνεται στη συσκευή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses speech recognition only to catch the Korean word “다음” (“next”). Processed on your device whenever possible."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses speech recognition only to catch the Korean word “다음” (“next”). Processed on your device whenever possible."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa el reconocimiento de voz solo para entender la palabra coreana «다음» («siguiente»). Siempre que es posible, se procesa en el dispositivo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käyttää puheentunnistusta vain korean sanan ”다음” (”seuraava”) tunnistamiseen. Käsittely tapahtuu mahdollisuuksien mukaan laitteella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilise la reconnaissance vocale uniquement pour repérer le mot coréen « 다음 » (« suivant »). Le traitement se fait sur l’appareil dans la mesure du possible."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menggunakan pengenalan suara hanya untuk menangkap kata Korea “다음” (“berikutnya”). Jika memungkinkan, diproses di perangkat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa il riconoscimento vocale solo per capire la parola coreana «다음» («avanti»). Quando possibile, l’elaborazione avviene sul dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "韓国語の「다음」（「次へ」）という言葉だけを聞き取るために、音声認識を使います。可能な限り端末内で処理します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"다음\"이라는 말만 알아듣기 위해 음성 인식을 씁니다. 가능하면 기기 안에서 처리합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruker talegjenkjenning bare for å fange opp det koreanske ordet «다음» («neste»). Behandles på enheten når det er mulig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruikt spraakherkenning alleen om het Koreaanse woord “다음” (“volgende”) te herkennen. Waar mogelijk wordt dit op het apparaat verwerkt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa o reconhecimento de fala apenas para entender a palavra coreana “다음” (“próximo”). Sempre que possível, o processamento é feito no aparelho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Распознавание речи используется только для того, чтобы услышать корейское слово «다음» («далее»). По возможности обработка идёт на устройстве."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้การรู้จำเสียงพูดเฉพาะเพื่อจับคำภาษาเกาหลี “다음” (“ถัดไป”) ประมวลผลบนเครื่องเมื่อเป็นไปได้"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dùng nhận dạng giọng nói chỉ để nghe từ tiếng Hàn “다음” (“tiếp theo”). Khi có thể, việc xử lý diễn ra ngay trên thiết bị."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用语音识别，只为听懂韩语“다음”（“下一步”）这个词。如有可能，会在设备上完成处理。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用語音辨識，只為聽懂韓語「다음」（「下一步」）這個詞。如有可能，會在裝置上完成處理。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
