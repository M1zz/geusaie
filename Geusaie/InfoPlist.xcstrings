    "NSMicrophoneUsageDescription" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikrofon slouží k tomu, abyste při vaření mohli slovem „další“ přejít na další krok."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikrofonen bruges, så du kan sige “næste” og gå videre til næste trin, mens du laver mad."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Mikrofon wird verwendet, damit du beim Kochen mit „weiter“ zum nächsten Schritt springen kannst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρησιμοποιεί το μικρόφωνο για να λέτε «επόμενο» και να περνάτε στο επόμενο βήμα ενώ μαγειρεύετε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses the microphone so you can say “next” to move to the next step while you cook."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses the microphone so you can say ‘next’ to move to the next step while you cook."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa el micrófono para que puedas decir «siguiente» y pasar al siguiente paso mientras cocinas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikrofonia käytetään, jotta voit ruokaa laittaessasi siirtyä seuraavaan vaiheeseen sanomalla ”seuraava”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le micro permet de dire « suivant » pour passer à l’étape d’après pendant que vous cuisinez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menggunakan mikrofon agar kamu bisa mengucapkan “berikutnya” untuk lanjut ke langkah berikutnya saat memasak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa il microfono per farti dire «avanti» e passare al passo successivo mentre cucini."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "調理中に「次へ」と言うだけで次の手順に進めるよう、マイクを使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "요리 중에 \"다음\" 한 마디로 단계를 넘기기 위해 마이크를 씁니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikrofonen brukes slik at du kan si «neste» for å gå til neste trinn mens du lager mat."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruikt de microfoon zodat je tijdens het koken ‘volgende’ kunt zeggen om naar de volgende stap te gaan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikrofon pozwala podczas gotowania przejść do następnego kroku słowem „dalej”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa o microfone para você dizer “próximo” e ir para a próxima etapa enquanto cozinha."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Микрофон нужен, чтобы во время готовки переходить к следующему шагу словом «далее»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikrofonen används så att du kan säga ”nästa” och gå till nästa steg medan du lagar mat."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้ไมโครโฟนเพื่อให้คุณพูดว่า “ถัดไป” แล้วไปยังขั้นตอนต่อไประหว่างทำอาหาร"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yemek yaparken “ileri” diyerek sonraki adıma geçebilmeniz için mikrofonu kullanır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dùng micrô để bạn nói “tiếp theo” và chuyển sang bước kế tiếp khi đang nấu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用麦克风，让你做饭时说“下一步”就能进入下一个步骤。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用麥克風，讓你烹飪時說「下一步」就能進到下一個步驟。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozpoznávání řeči slouží jen k zachycení slova „další“. Kdykoli je to možné, zpracovává se v zařízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talegenkendelse bruges kun til at fange ordet “næste”. Behandles på enheden, når det er muligt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Spracherkennung dient nur dazu, das Wort „weiter“ zu erkennen. Sie läuft nach Möglichkeit auf dem Gerät."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η αναγνώριση ομιλίας χρησιμοποιείται μόνο για τη λέξη «επόμενο». Η επεξεργασία γίνεται στη συσκευή όποτε είναι δυνατό."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses speech recognition only to catch the word “next”. Processed on your device whenever possible."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses speech recognition only to catch the word ‘next’. Processed on your device whenever possible."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa el reconocimiento de voz solo para detectar la palabra «siguiente». Se procesa en el dispositivo siempre que es posible."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puheentunnistusta käytetään vain sanan ”seuraava” tunnistamiseen. Käsittely tehdään laitteella aina kun mahdollista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La reconnaissance vocale sert uniquement à repérer le mot « suivant ». Le traitement se fait sur l’appareil dès que possible."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pengenalan suara hanya dipakai untuk menangkap kata “berikutnya”. Diproses di perangkat jika memungkinkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il riconoscimento vocale serve solo a cogliere la parola «avanti». L’elaborazione avviene sul dispositivo quando possibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声認識は「次へ」という言葉を聞き取るためだけに使います。可能な場合はデバイス上で処理します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"다음\"이라는 말만 알아듣기 위해 음성 인식을 씁니다. 가능하면 기기 안에서 처리합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talegjenkjenning brukes bare til å fange opp ordet «neste». Behandles på enheten når det er mulig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spraakherkenning wordt alleen gebruikt om het woord ‘volgende’ op te vangen. Waar mogelijk gebeurt dit op je apparaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozpoznawanie mowy służy tylko do wychwycenia słowa „dalej”. W miarę możliwości działa na urządzeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa o reconhecimento de voz só para captar a palavra “próximo”. O processamento é feito no aparelho sempre que possível."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Распознавание речи нужно только для слова «далее». По возможности обработка идёт на устройстве."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taligenkänning används bara för att uppfatta ordet ”nästa”. Behandlas på enheten när det går."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้การรู้จำเสียงพูดเพื่อจับคำว่า “ถัดไป” เท่านั้น และประมวลผลบนอุปกรณ์เมื่อทำได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konuşma tanıma yalnızca “ileri” kelimesini yakalamak için kullanılır. Mümkün olduğunda cihazda işlenir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ dùng nhận dạng giọng nói để bắt từ “tiếp theo”. Xử lý ngay trên thiết bị khi có thể."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "语音识别只用来听“下一步”这个词，并尽可能在设备上处理。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "語音辨識只用來聽「下一步」這個詞，並盡可能在裝置上處理。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
