    "고른 요리의 조리 화면을 열어요. 시작 버튼을 누르면 타이머가 돌아요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otevře obrazovku vaření vybraného jídla. Časovače se spustí klepnutím na Začít."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åbner madlavningsskærmen for den valgte ret. Timerne starter, når du trykker på Start."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnet die Kochansicht des gewählten Gerichts. Die Timer starten, sobald du auf Start tippst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ανοίγει την οθόνη μαγειρέματος της συνταγής που επιλέξατε. Οι χρονοδιακόπτες ξεκινούν όταν πατήσετε Έναρξη."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opens the cooking screen for the dish you pick. The timers start when you tap Start."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
