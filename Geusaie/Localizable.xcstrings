    "손은 다 했어요 — 냄비만 기다리면 돼요" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruce jsou hotové — zbývá jen čekat na hrnce"
