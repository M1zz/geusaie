    "대비를 높이거나 색을 구별하기 어려워도 냄비마다 상태를 알아볼 수 있어요." : {
      "comment" : "Roadmap item detail: a11y.contrast",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stav každého hrnce poznáte, i když zvýšíte kontrast nebo se barvy špatně rozlišují."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se, hvordan hver gryde har det, selv med øget kontrast eller hvis det er svært at kende forskel på farver."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du erkennst den Zustand jedes Topfs auch bei erhöhtem Kontrast oder wenn Farben schwer zu unterscheiden sind."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δείτε την κατάσταση κάθε κατσαρόλας ακόμη και με αυξημένη αντίθεση ή αν δυσκολεύεστε να ξεχωρίσετε χρώματα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See how each pot is doing, even with Increase Contrast on or if colors are hard to tell apart."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See how each pot is doing, even with Increase Contrast on or if colours are hard to tell apart."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes ver cómo va cada olla aunque subas el contraste o te cueste distinguir los colores."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näet jokaisen kattilan tilan, vaikka kontrastia olisi lisätty tai värien erottaminen olisi vaikeaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voyez l’état de chaque casserole même avec un contraste renforcé ou si les couleurs sont difficiles à distinguer."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Status tiap panci tetap terlihat, meski kontras ditingkatkan atau sulit membedakan warna."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riconosci lo stato di ogni pentola anche con il contrasto aumentato o se fai fatica a distinguere i colori."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コントラストを上げたり、色の区別がつきにくくても、鍋ごとの状態がわかります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대비를 높이거나 색을 구별하기 어려워도 냄비마다 상태를 알아볼 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se hvordan hver kjele har det, selv med økt kontrast eller hvis det er vanskelig å skille farger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zie hoe elke pan eraan toe is, ook met meer contrast of als kleuren moeilijk te onderscheiden zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobacz stan każdego garnka nawet przy zwiększonym kontraście lub gdy trudno rozróżniać kolory."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veja o estado de cada panela mesmo com contraste aumentado ou se for difícil distinguir cores."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Состояние каждой кастрюли понятно, даже если включён повышенный контраст или трудно различать цвета."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se hur varje gryta mår, även med ökad kontrast eller om det är svårt att skilja på färger."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ดูสถานะของแต่ละหม้อได้ แม้เปิดเพิ่มคอนทราสต์หรือแยกสีได้ยาก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karşıtlığı artırsanız ya da renkleri ayırt etmekte zorlansanız bile her tencerenin durumunu görün."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhìn rõ trạng thái từng nồi dù bạn tăng độ tương phản hoặc khó phân biệt màu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使调高了对比度，或不容易分辨颜色，也能看清每口锅的状态。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使調高了對比，或不容易分辨顏色，也能看清每個鍋子的狀態。"
          }
        }
      }
    },
