    "찌개와 반찬도 냄비마다 시간과 순서를 잡아, 늘 한쪽이 식던 두 가지를 함께 끝내요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I polévky a přílohy dostanou čas a pořadí pro každý hrnec, takže to, co vždycky vychladlo, je hotové spolu se zbytkem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gryderetter og tilbehør får også tid og rækkefølge for hver gryde, så det, der altid blev koldt, bliver færdigt samtidig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auch Eintöpfe und Beilagen bekommen Zeit und Reihenfolge für jeden Topf, damit das, was sonst immer kalt wurde, zusammen fertig wird."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Και τα στιφάδα με τα συνοδευτικά παίρνουν χρόνο και σειρά για κάθε κατσαρόλα, ώστε αυτό που πάντα κρύωνε να τελειώνει μαζί με το άλλο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stews and side dishes get a time and order for every pot too, so the one that always went cold finishes with the other."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stews and side dishes get a time and order for every pot too, so the one that always went cold finishes with the other."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guisos y acompañamientos también tienen tiempo y orden para cada olla, así lo que siempre se enfriaba termina a la vez."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Myös padat ja lisukkeet saavat ajan ja järjestyksen jokaiselle kattilalle, niin aina jäähtynyt valmistuu toisen kanssa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ragoûts et accompagnements ont aussi un temps et un ordre par casserole : celui qui refroidissait toujours finit avec l’autre."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sup dan lauk pendamping juga punya waktu dan urutan untuk tiap panci, jadi yang selalu dingin duluan kini selesai bersama."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anche stufati e contorni hanno tempi e ordine per ogni pentola, così quello che si raffreddava sempre finisce insieme all’altro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チゲとおかずも鍋ごとに時間と順番を決めて、いつもどちらかが冷めていた二品を一緒に仕上げます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gryter og tilbehør får også tid og rekkefølge for hver kjele, så det som alltid ble kaldt, blir ferdig samtidig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ook stoofpotten en bijgerechten krijgen tijd en volgorde per pan, zodat wat altijd koud werd samen klaar is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gulasze i dodatki też dostają czas i kolejność dla każdego garnka, więc to, co zawsze stygło, kończy się razem z resztą."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ensopados e acompanhamentos também ganham tempo e ordem para cada panela, e aquele que sempre esfriava termina junto com o outro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Супы и закуски тоже получают время и порядок для каждой кастрюли, и то, что всегда остывало, будет готово вместе с остальным."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grytor och tillbehör får också tid och ordning för varje kastrull, så det som alltid kallnade blir klart samtidigt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ซุปกับเครื่องเคียงก็ได้เวลาและลำดับของแต่ละหม้อ อาหารที่เคยเย็นชืดอยู่ฝั่งหนึ่งเสมอจะเสร็จพร้อมกัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Güveçler ve yan yemekler de her tencere için zaman ve sıra alır; hep soğuyan yemek artık diğeriyle birlikte biter."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canh và món phụ cũng có thời gian và thứ tự cho từng nồi, món luôn bị nguội trước giờ sẽ xong cùng món kia."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "汤和小菜也按每口锅排好时间和顺序，以前总有一样先凉的两道菜，现在一起做好。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "湯和小菜也依每個鍋排好時間和順序，以前總有一樣先涼掉的兩道菜，現在一起完成。"
          }
        }
      }
    },
