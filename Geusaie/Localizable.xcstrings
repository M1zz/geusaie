    "면 삶는 그사이에 소스까지." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatímco se vaří těstoviny, hotoví se i omáčka."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mens pastaen koger, bliver saucen også færdig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Während die Pasta kocht, wird auch die Soße fertig."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ενώ βράζουν τα ζυμαρικά, ετοιμάζεται και η σάλτσα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finish the sauce while the pasta boils."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finish the sauce while the pasta boils."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mientras la pasta hierve, la salsa también queda lista."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pastan kiehuessa myös kastike valmistuu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendant que les pâtes cuisent, la sauce se termine aussi."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat pasta direbus, saus pun ikut selesai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mentre la pasta bolle, anche il sugo è pronto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パスタを茹でている間に、ソースまで。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "면 삶는 그사이에 소스까지."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mens pastaen koker, blir også sausen ferdig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terwijl de pasta kookt, wordt ook de saus klaar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy makaron się gotuje, sos też się robi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enquanto o macarrão cozinha, o molho também fica pronto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пока варится паста, готов и соус."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Medan pastan kokar blir såsen också klar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ระหว่างที่เส้นพาสต้ากำลังต้ม ซอสก็เสร็จไปด้วย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Makarna kaynarken sos da hazır olur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trong lúc mì đang luộc, nước sốt cũng xong."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "煮意面的同时，把酱汁也做好。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "煮義大利麵的同時，把醬汁也做好。"
          }
        }
      }
    },
    "면 삶는 그사이에 소스까지. 냄비마다 무엇을 하는 중인지, 얼마나 남았는지 따로 보여 드려요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatímco se vaří těstoviny, hotoví se i omáčka. Každý hrnec ukazuje, co dělá a kolik zbývá času."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mens pastaen koger, bliver saucen også færdig. Hver gryde viser, hvad den laver, og hvor lang tid der er tilbage."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Während die Pasta kocht, wird auch die Soße fertig. Jeder Topf zeigt, was gerade passiert und wie viel Zeit noch bleibt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ενώ βράζουν τα ζυμαρικά, ετοιμάζεται και η σάλτσα. Κάθε κατσαρόλα δείχνει τι κάνει και πόσος χρόνος απομένει."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finish the sauce while the pasta boils. Each pot shows what it’s doing and how much time is left."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finish the sauce while the pasta boils. Each pot shows what it’s doing and how much time is left."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mientras la pasta hierve, la salsa también queda lista. Cada olla muestra qué está haciendo y cuánto tiempo le queda."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pastan kiehuessa myös kastike valmistuu. Jokainen kattila näyttää, mitä se tekee ja kuinka paljon aikaa on jäljellä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
