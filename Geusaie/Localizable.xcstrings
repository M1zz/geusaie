    "타기 쉬우니 바로 다음으로" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snadno se připálí — hned pokračujte dalším krokem"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brænder let på – gå straks videre til næste trin"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brennt leicht an – gleich weiter zum nächsten Schritt"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Καίγεται εύκολα — περάστε αμέσως στο επόμενο βήμα"
