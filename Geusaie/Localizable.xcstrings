    "요리하다 앱이 꺼져도 냄비 시간과 진행 상황이 그대로 이어져요." : {
      "comment" : "Roadmap item detail: autosave",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když se aplikace během vaření zavře, časovače hrnců i postup zůstanou zachované."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis appen lukker, mens du laver mad, bevares gryders timere og din fremgang."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn die App beim Kochen beendet wird, bleiben Topf-Timer und Fortschritt erhalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν η εφαρμογή κλείσει ενώ μαγειρεύετε, οι χρονοδιακόπτες των κατσαρολών και η πρόοδός σας διατηρούνται."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If the app closes mid-cook, your pot timers and progress carry right on."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If the app closes mid-cook, your pot timers and progress carry right on."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si la app se cierra mientras cocinas, los temporizadores de las ollas y tu progreso se conservan."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos sovellus sulkeutuu ruoanlaiton aikana, kattiloiden ajastimet ja edistyminen säilyvät."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si l’app se ferme pendant que vous cuisinez, les minuteurs des casseroles et votre progression sont conservés."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika aplikasi tertutup saat memasak, timer panci dan progres tetap berlanjut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se l’app si chiude mentre cucini, i timer delle pentole e i tuoi progressi restano così come sono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "調理中にアプリが終了しても、鍋のタイマーと進行状況はそのまま引き継がれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "요리하다 앱이 꺼져도 냄비 시간과 진행 상황이 그대로 이어져요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis appen lukkes mens du lager mat, beholdes kjelenes tidtakere og fremdriften din."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als de app tijdens het koken sluit, blijven de timers van de pannen en je voortgang behouden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli aplikacja zamknie się w trakcie gotowania, minutniki garnków i postęp zostaną zachowane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se o app fechar enquanto você cozinha, os timers das panelas e o progresso continuam de onde estavam."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если приложение закроется во время готовки, таймеры кастрюль и прогресс сохранятся."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om appen stängs medan du lagar mat bevaras grytornas timrar och dina framsteg."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แม้แอปปิดระหว่างทำอาหาร เวลาของหม้อและความคืบหน้าก็ยังต่อเนื่องเหมือนเดิม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yemek yaparken uygulama kapanırsa tencere zamanlayıcıları ve ilerlemeniz olduğu gibi korunur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu ứng dụng đóng giữa lúc đang nấu, thời gian của các nồi và tiến độ vẫn được giữ nguyên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "做菜时即使应用被关闭，锅的计时和进度也会照常接上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "做菜時就算 App 被關閉，鍋子的計時和進度也會照常接上。"
          }
        }
      }
    },
