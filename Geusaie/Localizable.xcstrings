    "끓는 동안 두부·파를 썰고 달걀을 풀어 두세요" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Během varu nakrájejte tofu a jarní cibulku a rozšlehejte vejce"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skær tofu og forårsløg, og pisk æggene, mens det koger"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Während es kocht, Tofu und Frühlingszwiebeln schneiden und die Eier verquirlen"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όσο βράζει, κόψτε το τόφου και το φρέσκο κρεμμύδι και χτυπήστε τα αυγά"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While it boils, cut the tofu and scallions and beat the eggs"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While it boils, cut the tofu and spring onions and beat the eggs"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mientras hierve, corta el tofu y la cebolleta y bate los huevos"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leikkaa kiehumisen aikana tofu ja kevätsipuli ja vatkaa munat"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendant que ça bout, couper le tofu et les oignons verts et battre les œufs"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selagi mendidih, potong tahu dan daun bawang lalu kocok telur"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mentre bolle, taglia tofu e cipollotto e sbatti le uova"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "煮ている間に豆腐とねぎを切り、卵を溶いておきましょう"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skjær tofu og vårløk og visp eggene mens det koker"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snijd tijdens het koken de tofu en lente-ui en klop de eieren los"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W trakcie gotowania pokrój tofu i dymkę, roztrzep jajka"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enquanto ferve, corte o tofu e a cebolinha e bata os ovos"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пока кипит, нарежьте тофу и зелёный лук и взбейте яйца"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skär tofu och salladslök och vispa äggen medan det kokar"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ระหว่างรอเดือด หั่นเต้าหู้กับต้นหอม แล้วตีไข่ไว้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaynarken tofuyu ve yeşil soğanı doğrayın, yumurtaları çırpın"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trong lúc sôi, cắt đậu phụ và hành, đánh trứng sẵn"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "煮的时候切好豆腐和葱，把鸡蛋打散"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
