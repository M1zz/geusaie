        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "焦げやすいのですぐ次へ"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "타기 쉬우니 바로 다음으로"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brenner seg lett – gå straks videre til neste trinn"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbrandt snel — ga meteen door naar de volgende stap"
