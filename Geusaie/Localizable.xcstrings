        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στη μεγάλη οθόνη ενός αναδιπλούμενου iPhone βλέπετε τις κατσαρόλες και τις εργασίες δίπλα δίπλα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See your pots and to-dos side by side on the wide screen of a foldable iPhone."
          }
        },
