    "앱 이름을 말하지 않아도 Siri에게 만들 요리를 말하면 조리 화면이 바로 열려요." : {
      "comment" : "Roadmap item detail: siri-ai",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Řekněte Siri, co chcete vařit, bez názvu aplikace, a obrazovka vaření se hned otevře."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sig til Siri, hvad du vil lave, uden at nævne appen, så åbner madlavningsskærmen med det samme."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sag Siri einfach, was du kochen möchtest – ohne App-Namen – und die Kochansicht öffnet sich sofort."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πείτε στη Siri τι θέλετε να μαγειρέψετε, χωρίς να αναφέρετε την εφαρμογή, και η οθόνη μαγειρέματος ανοίγει αμέσως."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tell Siri what you want to cook, no app name needed, and the cooking screen opens right away."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tell Siri what you want to cook, no app name needed, and the cooking screen opens straight away."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dile a Siri qué quieres cocinar, sin nombrar la app, y la pantalla de cocina se abrirá al instante."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kerro Sirille, mitä haluat tehdä ruoaksi, ilman sovelluksen nimeä, niin ruoanlaittonäyttö aukeaa heti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dites à Siri ce que vous voulez cuisiner, sans nommer l’app, et l’écran de cuisson s’ouvre aussitôt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cukup beri tahu Siri hidangan yang ingin dimasak, tanpa menyebut nama aplikasi, dan layar memasak langsung terbuka."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di’ a Siri cosa vuoi cucinare, senza nominare l’app, e la schermata di cottura si apre subito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリ名を言わなくても、作りたい料理をSiriに伝えるだけで調理画面がすぐに開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱 이름을 말하지 않아도 Siri에게 만들 요리를 말하면 조리 화면이 바로 열려요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
