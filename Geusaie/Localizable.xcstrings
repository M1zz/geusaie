    "칼을 눕혀 얇게 — 두꺼우면 속이 안 익고 겉만 타요" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nůž položte naplocho a krájejte tence — silné plátky jsou uvnitř syrové a zvenku se připálí"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold kniven fladt og skær tyndt – er de tykke, bliver de rå indeni og brændte udenpå"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Messer flach halten und dünn schneiden – dicke Scheiben bleiben innen roh und verbrennen außen"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Με το μαχαίρι σχεδόν οριζόντιο, λεπτά — αν είναι χοντρές, μέσα μένουν ωμές και απ' έξω καίγονται"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lay the knife flat and slice thin — thick slices stay raw inside and burn outside"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lay the knife flat and slice thin — thick slices stay raw inside and burn outside"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con el cuchillo inclinado, bien fino — si es grueso, queda crudo por dentro y se quema por fuera"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pidä veitsi litteänä ja leikkaa ohueksi – paksut siivut jäävät sisältä raaoiksi ja palavat päältä"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couteau à plat, bien fin — trop épais, l’ail reste cru à l’intérieur et brûle dehors"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rebahkan pisau dan iris tipis — kalau tebal, bagian dalamnya mentah sementara luarnya gosong"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coltello inclinato e fettine sottili — se sono spesse, dentro restano crude e fuori bruciano"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "包丁を寝かせて薄く — 厚いと中は生で外だけ焦げます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "칼을 눕혀 얇게 — 두꺼우면 속이 안 익고 겉만 타요"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold kniven flatt og skjær tynt – er de tykke, blir de rå inni og brente utenpå"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd het mes plat en snijd dun — dikke plakjes blijven van binnen rauw en verbranden aan de buitenkant"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trzymaj nóż płasko i krój cienko — grube plasterki w środku zostaną surowe, a na zewnątrz się przypalą"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com a faca deitada, fininho — se ficar grosso, fica cru por dentro e queima por fora"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Держите нож плашмя и режьте тонко — толстые пластинки внутри сырые, а снаружи подгорают"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håll kniven plant och skär tunt – tjocka skivor blir råa inuti och brända utanpå"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วางมีดเอียงแล้วหั่นบาง ๆ — ถ้าหนา ข้างในจะไม่สุกแต่ข้างนอกไหม้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bıçağı yatık tutup ince doğrayın — kalın olursa içi çiğ kalır, dışı yanar"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Để lưỡi dao nằm nghiêng và thái mỏng — dày thì bên trong chưa chín mà bên ngoài đã cháy"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刀放平，切薄一点 — 太厚的话里面不熟，外面却会糊"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刀放平，切薄一點 — 太厚的話裡面不熟，外面卻會焦"
          }
        }
      }
    },
