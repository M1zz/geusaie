    "아이패드를 세워 두면 지금 할 일과 냄비마다 남은 시간을 멀리서도 읽히게 크게 보여 줘요." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아이패드를 세워 두면 지금 할 일과 냄비마다 남은 시간을 멀리서도 읽히게 크게 보여 줘요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stand your iPad up to see what to do now and every pot's time left, big enough to read from across the kitchen."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stand your iPad up to see what to do now and every pan's time left, big enough to read from across the kitchen."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPadを立てておくと、今やることと鍋ごとの残り時間を離れていても読める大きさで表示します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把 iPad 立起来，当前要做的事和每口锅的剩余时间会大到隔着厨房也能看清。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把 iPad 立起來，現在要做的事和每個鍋子的剩餘時間會大到隔著廚房也看得清楚。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поставьте iPad — текущий шаг и время каждой кастрюли будут видны крупно даже издалека."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pon el iPad de pie y verás lo que toca ahora y el tiempo de cada olla en grande, legible desde lejos."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stell das iPad auf – der aktuelle Schritt und die Restzeit jedes Topfs sind dann auch aus der Ferne gut lesbar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posez l’iPad debout : l’étape en cours et le temps de chaque casserole s’affichent en grand, lisibles de loin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metti l’iPad in piedi: il passo attuale e il tempo di ogni pentola appaiono in grande, leggibili anche da lontano."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixe o iPad em pé e veja a etapa atual e o tempo de cada panela em tamanho grande, legível de longe."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตั้ง iPad ไว้ แล้วสิ่งที่ต้องทำตอนนี้และเวลาของแต่ละหม้อจะแสดงตัวใหญ่ อ่านได้แม้อยู่ไกล"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dựng iPad lên để thấy việc cần làm và thời gian từng nồi thật to, đứng xa vẫn đọc được."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postavte iPad a aktuální krok i čas každého hrnce uvidíte velkým písmem i z druhého konce kuchyně."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stil din iPad op, og se hvad du skal nu og hver grydes tid i stor skrift, der kan læses på afstand."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στήστε το iPad και δείτε το τρέχον βήμα και τον χρόνο κάθε κατσαρόλας σε μεγάλα γράμματα, ευανάγνωστα από μακριά."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nosta iPad pystyyn, niin nykyinen vaihe ja jokaisen kattilan aika näkyvät isolla myös kauempaa."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berdirikan iPad untuk melihat langkah sekarang dan sisa waktu tiap panci dalam ukuran besar, terbaca dari jauh."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sett iPad-en opp, så ser du hva du skal gjøre nå og tiden for hver gryte i stor skrift som kan leses på avstand."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet je iPad rechtop en zie de huidige stap en de tijd van elke pan groot genoeg om van een afstand te lezen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postaw iPada, a bieżący krok i czas każdego garnka zobaczysz dużymi literami, czytelnymi z daleka."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ställ upp din iPad så ser du vad du ska göra nu och varje kastrulls tid i stor text som syns på avstånd."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad’i ayakta bırakın; şu anki adım ve her tencerenin süresi uzaktan okunacak kadar büyük görünür."
          }
        }
      }
    },
