    "갈색이 되면 쓴맛 — 색이 오르면 불을 빼세요" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brauner Knoblauch wird bitter – sobald er Farbe annimmt, vom Herd ziehen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Browned garlic turns bitter — pull it off the heat as it darkens"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Browned garlic turns bitter — pull it off the heat as it darkens"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El ajo dorado amarga — retíralo del fuego en cuanto coja color"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’ail trop doré devient amer — dès qu’il prend de la couleur, retirer du feu"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’aglio scuro diventa amaro — appena prende colore, togli dal fuoco"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "茶色くなると苦くなる — 色づいてきたら火から外して"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "갈색이 되면 쓴맛 — 색이 오르면 불을 빼세요"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alho muito dourado amarga — assim que ganhar cor, tire do fogo"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подрумяненный чеснок горчит — как только темнеет, снимайте с огня"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กระเทียมสีน้ำตาลจะขม — พอสีเริ่มเข้มให้ยกออกจากไฟ"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "变成褐色就会发苦 — 颜色一变深就离火"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "變成褐色就會發苦 — 顏色一變深就離火"
          }
        }
      }
    },
