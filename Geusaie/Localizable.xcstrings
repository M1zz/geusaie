    "1분 덜 삶기 — 소스에서 마저 익힘" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O 1 minutu méně — dojdou v omáčce"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 minut mindre – den bliver færdig i saucen"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 Minute kürzer – gar wird sie in der Soße"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 λεπτό λιγότερο — ολοκληρώνονται στη σάλτσα"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 minute less — it finishes in the sauce"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 minute less — it finishes in the sauce"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 minuto menos — termina de hacerse en la salsa"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minuutti vähemmän – valmistuu kastikkeessa"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 minute de moins — elles finissent de cuire dans la sauce"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 menit lebih singkat — dituntaskan di dalam saus"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 minuto in meno — finisce di cuocere nel sugo"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1分短く茹でる — 残りはソースの中で火を通す"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1분 덜 삶기 — 소스에서 마저 익힘"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 minutt kortere – den blir ferdig i sausen"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 minuut korter — hij wordt gaar in de saus"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O 1 minutę krócej — dojdzie w sosie"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 minuto a menos — termina de cozinhar no molho"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На 1 минуту меньше — доходит в соусе"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 minut kortare – den blir klar i såsen"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ต้มน้อยลง 1 นาที — ไปสุกต่อในซอส"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 dakika az — sosta pişmeyi tamamlar"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ít hơn 1 phút — phần còn lại chín trong nước sốt"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "少煮 1 分钟 — 剩下的在酱汁里煮熟"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "少煮 1 分鐘 — 剩下的在醬汁裡煮熟"
          }
        }
      }
    },
    "VoiceOver가 냄비 시간과 할 일을 빠짐없이, 알맞은 순서로 읽어 줘요." : {
      "comment" : "Roadmap item detail: a11y.voiceover",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver čte časy všech hrnců i úkoly bez vynechání a ve správném pořadí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver læser alle gryders tider og opgaver op uden at springe noget over og i den rigtige rækkefølge."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver liest alle Topf-Timer und Aufgaben lückenlos und in der richtigen Reihenfolge vor."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το VoiceOver διαβάζει όλους τους χρόνους των κατσαρολών και τις εργασίες, χωρίς παραλείψεις και με τη σωστή σειρά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver reads every pot timer and to-do, in the right order."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver reads every pot timer and to-do, in the right order."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver lee todos los tiempos de las ollas y las tareas, sin saltarse nada y en el orden correcto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver lukee kaikkien kattiloiden ajat ja tehtävät ääneen ilman puutteita ja oikeassa järjestyksessä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver lit tous les minuteurs des casseroles et les tâches, sans rien oublier et dans le bon ordre."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver membacakan semua waktu panci dan tugas tanpa terlewat, dengan urutan yang tepat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver legge tutti i timer delle pentole e le cose da fare, senza saltare nulla e nell’ordine giusto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOverが、鍋のタイマーとやることを漏れなく、順番どおりに読み上げます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver가 냄비 시간과 할 일을 빠짐없이, 알맞은 순서로 읽어 줘요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver leser opp alle kjelenes tider og oppgaver uten å hoppe over noe og i riktig rekkefølge."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver leest alle pannentijden en taken voor, zonder iets over te slaan en in de juiste volgorde."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver czyta czasy wszystkich garnków i zadania bez pomijania i w odpowiedniej kolejności."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O VoiceOver lê todos os timers das panelas e tarefas, sem pular nada e na ordem certa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver зачитывает время каждой кастрюли и все дела без пропусков и в нужном порядке."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver läser upp alla grytors tider och uppgifter utan att hoppa över något och i rätt ordning."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver อ่านเวลาของทุกหม้อและงานที่ต้องทำให้ครบถ้วนตามลำดับที่เหมาะสม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver tüm tencere sürelerini ve işleri eksiksiz, doğru sırayla okur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver đọc đầy đủ thời gian của từng nồi và các việc cần làm, theo đúng thứ tự."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver 会不遗漏地、按合适的顺序朗读每口锅的时间和要做的事。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver 會不遺漏地、依合適的順序朗讀每個鍋子的時間和要做的事。"
          }
        }
      }
    },
