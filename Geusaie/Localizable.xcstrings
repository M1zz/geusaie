        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "면 삶는 그사이에 소스까지. 냄비마다 무엇을 하는 중인지, 얼마나 남았는지 따로 보여 드려요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mens pastaen koker, blir også sausen ferdig. Hver kjele viser hva den gjør og hvor mye tid som er igjen."
