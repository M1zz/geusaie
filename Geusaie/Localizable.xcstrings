    "타이머가 초기화되고 진행 상황이 사라집니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Časovače se vynulují a postup se ztratí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timerne nulstilles, og din fremgang går tabt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Timer werden zurückgesetzt und der Fortschritt geht verloren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι χρονοδιακόπτες θα μηδενιστούν και η πρόοδος θα χαθεί."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The timers will reset and your progress will be lost."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The timers will reset and your progress will be lost."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los temporizadores se reiniciarán y se perderá el progreso."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajastimet nollataan ja edistyminen katoaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les minuteurs seront réinitialisés et votre progression sera perdue."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timer akan diatur ulang dan progres akan hilang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I timer verranno azzerati e i progressi andranno persi."
