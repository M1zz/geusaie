    "아직 남은 단계가 있어요. 지금 멈추면 진행 상황이 사라집니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zbývají ještě kroky. Pokud teď přestanete, postup se ztratí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der er stadig trin tilbage. Hvis du stopper nu, går din fremgang tabt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es sind noch Schritte offen. Wenn du jetzt aufhörst, geht der Fortschritt verloren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Υπάρχουν ακόμη βήματα. Αν σταματήσετε τώρα, η πρόοδος θα χαθεί."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There are steps left. If you stop now, your progress will be lost."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There are steps left. If you stop now, your progress will be lost."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún quedan pasos. Si te detienes ahora, se perderá el progreso."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaiheita on vielä jäljellä. Jos lopetat nyt, edistyminen katoaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il reste des étapes. Si vous vous arrêtez maintenant, votre progression sera perdue."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masih ada langkah yang tersisa. Jika berhenti sekarang, progres akan hilang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ci sono ancora dei passaggi. Se ti fermi ora, i progressi andranno persi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まだ残りの手順があります。ここで止めると進行状況は消えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 남은 단계가 있어요. 지금 멈추면 진행 상황이 사라집니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
