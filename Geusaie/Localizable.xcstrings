    "갈색이 되면 쓴맛 — 색이 오르면 불을 빼세요" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zhnědlý česnek je hořký — jakmile ztmavne, stáhněte z ohně"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brunt hvidløg bliver bittert – tag det af varmen, så snart det tager farve"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brauner Knoblauch wird bitter – sobald er Farbe annimmt, vom Herd ziehen"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το σκόρδο που καφετιάζει πικρίζει — μόλις σκουρύνει, τραβήξτε το από τη φωτιά"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Browned garlic turns bitter — pull it off the heat as it darkens"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Browned garlic turns bitter — pull it off the heat as it darkens"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El ajo dorado amarga — retíralo del fuego en cuanto coja color"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruskea valkosipuli on karvasta – ota pois lämmöltä heti kun väri tummuu"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’ail trop doré devient amer — dès qu’il prend de la couleur, retirer du feu"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bawang putih yang cokelat jadi pahit — begitu warnanya mulai gelap, angkat dari api"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’aglio scuro diventa amaro — appena prende colore, togli dal fuoco"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "茶色くなると苦くなる — 色づいてきたら火から外して"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "갈색이 되면 쓴맛 — 색이 오르면 불을 빼세요"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brun hvitløk blir bitter – ta den av varmen så fort den får farge"
          }
        },
        "nl" : {
          "stringUnit" : {
