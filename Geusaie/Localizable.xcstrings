    "면이 익는 그사이에 소스까지, 지금 담긴 레시피 전부 무료." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omáčka hotová, zatímco se vaří těstoviny, a všechny současné recepty zdarma."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saucen bliver færdig, mens pastaen koger, og alle opskrifter her er gratis."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Soße ist fertig, während die Pasta kocht, und alle Rezepte hier sind kostenlos."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η σάλτσα έτοιμη όσο βράζουν τα ζυμαρικά, και όλες οι τωρινές συνταγές δωρεάν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The sauce is done while the pasta cooks, and every recipe here now is free."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The sauce is done while the pasta cooks, and every recipe here now is free."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La salsa lista mientras se cuece la pasta, y todas las recetas actuales gratis."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kastike valmistuu pastan kiehuessa, ja kaikki nykyiset reseptit ovat ilmaisia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sauce est prête pendant que les pâtes cuisent, et toutes les recettes actuelles sont gratuites."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saus selesai selagi pasta direbus, dan semua resep yang ada sekarang gratis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La salsa è pronta mentre la pasta cuoce, e tutte le ricette attuali sono gratis."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パスタを茹でている間にソースまで。今あるレシピはすべて無料。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sausen blir ferdig mens pastaen koker, og alle oppskriftene her er gratis."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De saus is klaar terwijl de pasta kookt, en alle recepten van nu zijn gratis."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sos gotowy, zanim ugotuje się makaron, a wszystkie obecne przepisy są za darmo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O molho fica pronto enquanto a massa cozinha, e todas as receitas de agora são grátis."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Соус готов, пока варится паста, а все нынешние рецепты бесплатны."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Såsen blir klar medan pastan kokar, och alla recept här just nu är gratis."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทำซอสเสร็จระหว่างต้มเส้น สูตรที่มีตอนนี้ฟรีทั้งหมด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
