    "냄비가 다 되면 손목이 울리고, 손목에서 바로 다음 단계로 넘겨요." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "냄비가 다 되면 손목이 울리고, 손목에서 바로 다음 단계로 넘겨요."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your wrist taps when a pot is done, and you can move to the next step right from your wrist."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your wrist taps when a pan is done, and you can move to the next step right from your wrist."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鍋ができると手首に通知が届き、そのまま手首で次のステップに進めます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "锅煮好时手腕会振动，直接在手腕上就能进入下一步。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鍋子煮好時手腕會震動，直接在手腕上就能進入下一步。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда кастрюля готова, часы вибрируют, и следующий шаг можно отметить прямо с запястья."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando una olla está lista, notas un toque en la muñeca y puedes pasar al siguiente paso desde ahí."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ist ein Topf fertig, tippt die Uhr ans Handgelenk – und du gehst direkt dort zum nächsten Schritt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand une casserole est prête, votre poignet vibre et vous passez à l’étape suivante directement depuis la montre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando una pentola è pronta il polso vibra, e puoi passare al passo successivo direttamente dall’orologio."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando uma panela fica pronta, o pulso vibra e você avança para a próxima etapa direto no relógio."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อหม้อเสร็จ ข้อมือจะสั่น และกดไปขั้นต่อไปได้จากข้อมือทันที"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi nồi xong, cổ tay sẽ rung và bạn chuyển sang bước tiếp theo ngay trên đồng hồ."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když je hrnec hotový, ucítíte klepnutí na zápěstí a další krok potvrdíte přímo z hodinek."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når en gryde er færdig, mærker du et prik på håndleddet og kan gå videre til næste trin derfra."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν μια κατσαρόλα είναι έτοιμη, ο καρπός σας δονείται και περνάτε στο επόμενο βήμα από το ρολόι."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun kattila on valmis, ranne värähtää ja voit siirtyä seuraavaan vaiheeseen suoraan kellosta."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat panci selesai, pergelangan tangan bergetar dan Anda bisa lanjut ke langkah berikutnya langsung dari jam."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når en gryte er ferdig, kjenner du et prikk på håndleddet og kan gå videre til neste steg derfra."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is een pan klaar, dan tikt je pols en ga je meteen vanaf je horloge door naar de volgende stap."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy garnek jest gotowy, poczujesz wibrację na nadgarstku i przejdziesz do następnego kroku prosto z zegarka."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När en kastrull är klar känner du ett tryck på handleden och går vidare till nästa steg direkt därifrån."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tencere hazır olunca bileğiniz titrer ve bir sonraki adıma doğrudan saatten geçersiniz."
          }
        }
      }
    },
