    "버튼을 누르거나, 손이 젖었으면 \"다음\"이라고 말하세요. 냄비가 다 되면 알림으로 알려 드려요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klepněte na tlačítko, nebo když máte mokré ruce, řekněte „další“. Když je hrnec hotový, přijde oznámení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk på knappen, eller sig “næste”, hvis du har våde hænder. Du får en notifikation, når en gryde er færdig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf den Button oder sag bei nassen Händen „weiter“. Wenn ein Topf fertig ist, bekommst du eine Mitteilung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πατήστε το κουμπί ή, αν έχετε βρεγμένα χέρια, πείτε «επόμενο». Όταν μια κατσαρόλα είναι έτοιμη, θα λάβετε ειδοποίηση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap the button, or say “next” if your hands are wet. You’ll get a notification when a pot is ready."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap the button, or say ‘next’ if your hands are wet. You’ll get a notification when a pan is ready."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca el botón o, si tienes las manos mojadas, di «siguiente». Te avisaremos con una notificación cuando una olla esté lista."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napauta painiketta tai sano märin käsin ”seuraava”. Saat ilmoituksen, kun kattila on valmis."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez le bouton ou, si vous avez les mains mouillées, dites « suivant ». Une notification vous prévient quand une casserole est prête."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketuk tombol, atau ucapkan “berikutnya” kalau tangan sedang basah. Kamu akan dapat notifikasi saat panci sudah siap."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca il pulsante o, se hai le mani bagnate, di’ «avanti». Quando una pentola è pronta ricevi una notifica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ボタンをタップするか、手が濡れていたら「次へ」と言ってください。鍋ができたら通知でお知らせします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "버튼을 누르거나, 손이 젖었으면 \"다음\"이라고 말하세요. 냄비가 다 되면 알림으로 알려 드려요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk på knappen, eller si «neste» hvis du er våt på hendene. Du får et varsel når en kjele er ferdig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op de knop, of zeg ‘volgende’ als je natte handen hebt. Je krijgt een melding als een pan klaar is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuknij przycisk albo, gdy masz mokre ręce, powiedz „dalej”. Kiedy garnek będzie gotowy, dostaniesz powiadomienie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque no botão ou, se estiver com as mãos molhadas, diga “próximo”. Você recebe uma notificação quando uma panela fica pronta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите кнопку или, если руки мокрые, скажите «далее». Когда кастрюля будет готова, придёт уведомление."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck på knappen, eller säg ”nästa” om du är blöt om händerna. Du får en notis när en gryta är klar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แตะปุ่ม หรือถ้ามือเปียกก็พูดว่า “ถัดไป” เมื่อหม้อไหนเสร็จจะมีการแจ้งเตือน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düğmeye dokunun ya da elleriniz ıslaksa “ileri” deyin. Bir tencere hazır olunca bildirim alırsınız."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chạm vào nút, hoặc nếu tay đang ướt thì nói “tiếp theo”. Khi một nồi xong, bạn sẽ nhận được thông báo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点按按钮，或者手湿的时候直接说“下一步”。锅里的东西好了会发通知提醒你。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點一下按鈕，或手濕的時候直接說「下一步」。鍋子好了會用通知提醒你。"
          }
        }
      }
    },
