        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İki makarna tarifi her zaman ücretsiz. Daha fazla yemeği yıllık abonelikle veya ömür boyu açın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
