    "김치찌개와 계란말이, 된장찌개와 애호박전을 냄비마다 시간과 순서를 잡아 함께 끝내요." : {
      "comment" : "Roadmap item detail: packs.stew",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kimči polévka s rolovanou omeletou a polévka s doenjangem s cuketovými placičkami, každý hrnec s časem a pořadím, aby bylo vše hotové najednou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kimchigryde med rullet omelet og doenjanggryde med squashfrikadeller, hver gryde med tid og rækkefølge, så alt bliver færdigt samtidig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kimchi-Eintopf mit Omelettrolle und Doenjang-Eintopf mit Zucchini-Puffern, jeder Topf mit Zeit und Reihenfolge, damit alles zusammen fertig wird."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στιφάδο κίμτσι με ρολό ομελέτα και στιφάδο ντουένγιανγκ με τηγανίτες κολοκυθιού, κάθε κατσαρόλα με χρόνο και σειρά ώστε όλα να τελειώνουν μαζί."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kimchi stew with a rolled omelette and doenjang stew with zucchini fritters, every pot timed and ordered to finish together."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kimchi stew with a rolled omelette and doenjang stew with courgette fritters, every pot timed and ordered to finish together."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guiso de kimchi con tortilla enrollada y guiso de doenjang con buñuelos de calabacín, cada olla con su tiempo y su orden para terminar a la vez."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kimchipata ja kääretty munakas sekä doenjang-pata ja kesäkurpitsaletut, jokaiselle kattilalle aika ja järjestys, jotta kaikki valmistuu yhtä aikaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ragoût de kimchi et omelette roulée, ragoût de doenjang et beignets de courgette : chaque casserole a son temps et son ordre pour finir ensemble."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sup kimchi dengan telur gulung dan sup doenjang dengan jeon zukini, tiap panci punya waktu dan urutan agar selesai bersama."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stufato di kimchi con frittata arrotolata e stufato di doenjang con frittelle di zucchine, ogni pentola con tempi e ordine per finire insieme."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キムチチゲと卵焼き、テンジャンチゲとズッキーニのジョンを、鍋ごとに時間と順番を決めて一緒に仕上げます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kimchigryte med rullet omelett og doenjanggryte med squashpuffer, hver kjele med tid og rekkefølge så alt blir ferdig samtidig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kimchistoof met opgerolde omelet en doenjangstoof met courgettebeignets, elke pan met tijd en volgorde zodat alles samen klaar is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gulasz z kimchi ze zwijanym omletem i gulasz z doenjangiem z plackami z cukinii, każdy garnek z czasem i kolejnością, by wszystko było gotowe razem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ensopado de kimchi com omelete enrolado e ensopado de doenjang com bolinhos de abobrinha, cada panela com tempo e ordem para terminar junto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кимчи-тиге с яичным рулетом и твенджан-тиге с оладьями из кабачка: у каждой кастрюли своё время и порядок, чтобы всё было готово одновременно."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kimchigryta med rullad omelett och doenjanggryta med zucchinibiffar, varje kastrull med tid och ordning så att allt blir klart samtidigt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จิเกกิมจิกับไข่ม้วน จิเกเทนจังกับจอนซูกินี จัดเวลาและลำดับของแต่ละหม้อให้เสร็จพร้อมกัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kimchi güveci ile rulo omlet, doenjang güveci ile kabak mücveri; her tencerenin zamanı ve sırası, hepsi birlikte bitsin diye."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canh kim chi với trứng cuộn, canh tương đậu với bánh bí ngòi, mỗi nồi có thời gian và thứ tự để cùng xong một lúc."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "泡菜汤配鸡蛋卷、大酱汤配西葫芦煎饼，每口锅都排好时间和顺序，一起做好。"
