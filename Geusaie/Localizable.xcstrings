{
  "sourceLanguage" : "ko",
  "strings" : {
    "\"다음\"이라는 말만 알아듣고, 소리는 저장하지 않아요" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reaguje jen na slovo „další“ a nikdy neukládá zvuk"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lytter kun efter ordet “næste” og gemmer aldrig lyd"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hört nur auf das Wort „weiter“ und speichert keinen Ton"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ακούει μόνο τη λέξη «επόμενο» και δεν αποθηκεύει ποτέ ήχο"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Listens only for the word “next” and never saves audio"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Listens only for the word ‘next’ and never saves audio"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo reconoce la palabra «siguiente» y nunca guarda audio"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuuntelee vain sanaa ”seuraava” eikä tallenna ääntä"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "N’écoute que le mot « suivant » et n’enregistre jamais le son"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya mendengar kata “berikutnya” dan tidak pernah menyimpan suara"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riconosce solo la parola «avanti» e non salva mai l’audio"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「次へ」という言葉だけを聞き取り、音声は保存しません"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"다음\"이라는 말만 알아듣고, 소리는 저장하지 않아요"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lytter bare etter ordet «neste» og lagrer aldri lyd"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luistert alleen naar het woord ‘volgende’ en slaat nooit geluid op"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reaguje tylko na słowo „dalej” i nigdy nie zapisuje dźwięku"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só reconhece a palavra “próximo” e nunca grava o áudio"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Реагирует только на слово «далее» и не сохраняет звук"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lyssnar bara efter ordet ”nästa” och sparar aldrig ljud"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ฟังแค่คำว่า “ถัดไป” และไม่บันทึกเสียงใดๆ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca “ileri” kelimesini dinler, sesi asla kaydetmez"
