    "요리는 그대로 열어 두었어요. Pro면 손에 밀가루가 묻어 있어도 말로 레시피를 바로 열어요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jídlo je otevřené jako obvykle. S Pro otevřete recept hlasem, i když máte ruce od mouky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retten er åben som altid. Med Pro åbner du opskrifter med stemmen, selv med mel på hænderne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Gericht ist wie gewohnt geöffnet. Mit Pro öffnest du Rezepte per Stimme, auch mit Mehl an den Händen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το φαγητό σας είναι ανοιχτό όπως πάντα. Με το Pro ανοίγετε συνταγές με τη φωνή, ακόμη και με αλεύρι στα χέρια."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your dish is open as usual. With Pro, open a recipe by voice even with flour on your hands."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your dish is open as usual. With Pro, open a recipe by voice even with flour on your hands."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu plato está abierto como siempre. Con Pro, abre recetas con la voz aunque tengas harina en las manos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruoka on auki tavalliseen tapaan. Prolla avaat reseptin äänellä, vaikka käsissä olisi jauhoja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre plat est ouvert comme d’habitude. Avec Pro, ouvrez une recette à la voix, même les mains pleines de farine."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masakan tetap terbuka seperti biasa. Dengan Pro, buka resep dengan suara meski tangan penuh tepung."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il piatto è aperto come sempre. Con Pro apri le ricette con la voce, anche con le mani sporche di farina."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "料理はそのまま開いてあります。Pro なら手に粉がついていても、声でレシピをすぐ開けます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retten er åpen som vanlig. Med Pro åpner du oppskrifter med stemmen, selv med mel på hendene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je gerecht staat gewoon open. Met Pro open je recepten met je stem, ook met bloem aan je handen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Danie jest otwarte jak zwykle. Z Pro otworzysz przepis głosem, nawet z mąką na rękach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
