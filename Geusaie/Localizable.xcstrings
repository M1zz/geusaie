        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It burns easily — move on right away"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It burns easily — move on right away"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se quema fácil: pasa enseguida al siguiente paso"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palaa helposti – siirry heti seuraavaan vaiheeseen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il brûle facilement — passer tout de suite à la suite"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mudah gosong — langsung lanjut ke langkah berikutnya"
