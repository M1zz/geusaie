    "파스타 두 접시는 언제나 무료예요. 더 많은 요리를 연 구독이나 평생으로 여세요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dva recepty na těstoviny zůstávají zdarma. Odemkněte další jídla ročním předplatným nebo natrvalo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De to pastaopskrifter forbliver gratis. Lås op for flere retter årligt eller for altid."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die zwei Pasta-Rezepte bleiben kostenlos. Schalte mehr Gerichte jährlich oder dauerhaft frei."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι δύο συνταγές ζυμαρικών μένουν δωρεάν. Ξεκλειδώστε περισσότερα πιάτα με ετήσια συνδρομή ή εφ’ όρου ζωής."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The two pasta recipes stay free. Unlock more dishes yearly or for life."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The two pasta recipes stay free. Unlock more dishes yearly or for life."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las dos recetas de pasta siguen gratis. Desbloquea más platos con la suscripción anual o de por vida."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaksi pastareseptiä pysyvät ilmaisina. Avaa lisää ruokia vuositilauksella tai pysyvästi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les deux recettes de pâtes restent gratuites. Débloquez plus de plats à l’année ou à vie."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dua resep pasta tetap gratis. Buka lebih banyak masakan dengan langganan tahunan atau seumur hidup."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le due ricette di pasta restano gratis. Sblocca altri piatti con l’abbonamento annuale o a vita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パスタの2品はずっと無料です。もっと多くの料理を年額か買い切りで開きましょう。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De to pastaoppskriftene er fortsatt gratis. Lås opp flere retter årlig eller for alltid."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De twee pastarecepten blijven gratis. Ontgrendel meer gerechten per jaar of voor altijd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dwa przepisy na makaron zostają za darmo. Odblokuj więcej dań w subskrypcji rocznej lub dożywotnio."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As duas receitas de massa continuam grátis. Libere mais pratos com a assinatura anual ou vitalícia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Два рецепта пасты остаются бесплатными. Откройте больше блюд по годовой подписке или навсегда."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De två pastarecepten förblir gratis. Lås upp fler rätter per år eller för alltid."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "พาสต้าสองจานยังฟรีเสมอ ปลดล็อกเมนูเพิ่มด้วยแบบรายปีหรือตลอดชีพ"
          }
