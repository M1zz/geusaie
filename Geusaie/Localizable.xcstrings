{
  "sourceLanguage" : "ko",
  "strings" : {
    "\"다음\"이라는 말만 알아듣고, 소리는 저장하지 않아요" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hört nur auf das koreanische Wort „다음“ („weiter“) und speichert keinen Ton"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Listens only for the Korean word “다음” (“next”) and never saves audio"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Listens only for the Korean word “다음” (“next”) and never saves audio"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo escucha la palabra coreana «다음» («siguiente») y nunca guarda el audio"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "N’écoute que le mot coréen « 다음 » (« suivant ») et n’enregistre jamais le son"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ascolta solo la parola coreana «다음» («avanti») e non salva mai l’audio"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "韓国語の「다음」（「次へ」）だけを聞き取り、音声は保存しません"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"다음\"이라는 말만 알아듣고, 소리는 저장하지 않아요"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só escuta a palavra coreana “다음” (“próximo”) e nunca grava o áudio"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Реагирует только на корейское слово «다음» («далее»), звук не сохраняется"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ฟังเฉพาะคำภาษาเกาหลี “다음” (“ถัดไป”) และไม่บันทึกเสียงไว้"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只识别韩语“다음”（“下一步”），不会保存任何声音"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只辨識韓語「다음」（「下一步」），不會儲存任何聲音"
          }
        }
      }
    },
