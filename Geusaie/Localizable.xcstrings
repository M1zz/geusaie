    "대비를 높이거나 색을 구별하기 어려워도 냄비마다 상태를 알아볼 수 있어요." : {
      "comment" : "Roadmap item detail: a11y.contrast",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du erkennst den Zustand jedes Topfs auch bei erhöhtem Kontrast oder wenn Farben schwer zu unterscheiden sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See how each pot is doing, even with Increase Contrast on or if colors are hard to tell apart."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See how each pot is doing, even with Increase Contrast on or if colours are hard to tell apart."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes ver cómo va cada olla aunque subas el contraste o te cueste distinguir los colores."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コントラストを上げたり、色の区別がつきにくくても、鍋ごとの状態がわかります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대비를 높이거나 색을 구별하기 어려워도 냄비마다 상태를 알아볼 수 있어요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Состояние каждой кастрюли понятно, даже если включён повышенный контраст или трудно различать цвета."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使调高了对比度，或不容易分辨颜色，也能看清每口锅的状态。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使調高了對比，或不容易分辨顏色，也能看清每個鍋子的狀態。"
          }
        }
      }
    },
