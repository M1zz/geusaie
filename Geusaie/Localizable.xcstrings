    "칼을 눕혀 얇게 — 두꺼우면 속이 안 익고 겉만 타요" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Messer flach halten und dünn schneiden – dicke Scheiben bleiben innen roh und verbrennen außen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lay the knife flat and slice thin — thick slices stay raw inside and burn outside"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lay the knife flat and slice thin — thick slices stay raw inside and burn outside"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con el cuchillo inclinado, bien fino — si es grueso, queda crudo por dentro y se quema por fuera"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couteau à plat, bien fin — trop épais, l’ail reste cru à l’intérieur et brûle dehors"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coltello inclinato e fettine sottili — se sono spesse, dentro restano crude e fuori bruciano"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "包丁を寝かせて薄く — 厚いと中は生で外だけ焦げます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "칼을 눕혀 얇게 — 두꺼우면 속이 안 익고 겉만 타요"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com a faca deitada, fininho — se ficar grosso, fica cru por dentro e queima por fora"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Держите нож плашмя и режьте тонко — толстые пластинки внутри сырые, а снаружи подгорают"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วางมีดเอียงแล้วหั่นบาง ๆ — ถ้าหนา ข้างในจะไม่สุกแต่ข้างนอกไหม้"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刀放平，切薄一点 — 太厚的话里面不熟，外面却会糊"
          }
        },
        "zh-Hant" : {
